# Public (safe for the browser / Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only (Netlify Functions / Netlify Dev) — never prefix with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SHIPPING_RATE_ID=shr_...

# Optional additional flat rates (discovered automatically by prefix)
# STRIPE_SHIPPING_RATE_ID_EXPRESS=shr_...

# Public site URL used for Checkout success/cancel redirects and origin checks.
# Netlify also sets URL / DEPLOY_PRIME_URL automatically in deployed contexts.
SITE_URL=http://localhost:8888
